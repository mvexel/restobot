# Copy to .env and fill in. docker compose / podman-compose auto-load this file
# for ${VAR} interpolation in docker-compose.yml, so you never have to pass
# these on the command line. An exported shell variable of the same name wins
# over the value here.

# Required: identifying string with a contact address, per Nominatim policy.
NOMINATIM_USER_AGENT=restobot/1.0 (+https://codeberg.org/mvexel/restobot)

# Mastodon target. Required for a real toot; leave blank when DRY_RUN=1.
MASTO_BASE_URL=https://botsin.space
MASTO_ACCESS_TOKEN=

# Set to 1 to print one post without sending it or updating posted.txt.
DRY_RUN=1
